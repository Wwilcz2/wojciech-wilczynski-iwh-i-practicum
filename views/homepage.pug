doctype html
html
  head
    meta(charset="utf-8")
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    .page-header
      h1= title
      

    if error
      p(style="color:red") Error: #{error}
    else if data && data.length
      .table-container
        table.data-table
          thead
            tr
              th ID
              th Name
              th Company
              th Codename
          tbody
            each record in data
              tr
                td= record.id
                td= record.properties.name || '-'
                td= record.properties.company || '-'
                td= record.properties.codename || '-'
    else
      p No records found. Use the form below to create one.

    // Add form under the table
    .form-container
      h2 Add a new record
      form(action="/update-cobj", method="post")
        .form-grid
          .form-field
            label(for="name") Name
            input(type="text", id="name", name="name", required)
          .form-field
            label(for="company") Company
            input(type="text", id="company", name="company", required)
          .form-field
            label(for="codename") Codename
            input(type="text", id="codename", name="codename", required)
        .form-actions
          button(type="submit") Submit
